# Copie este arquivo para .env.local e preencha com seus próprios valores.
# .env.local nunca é commitado (ver .gitignore) — cada pessoa/ambiente tem o seu.

# Obrigatória. Connection string do Postgres do Supabase.
# Painel do Supabase → Connect → aba "Direto" → método "Session pooler" →
# copie a string e substitua [YOUR-PASSWORD] pela senha real do banco.
DATABASE_URL=postgresql://postgres.xxxxx:SENHA@aws-0-xxxxx.pooler.supabase.com:5432/postgres

# Opcional em dev (tem um valor padrão no código, mas troque em produção).
# AUTH_SECRET=uma-string-longa-e-aleatoria
